/**booking.wxss**/

.booking-header {
  background-color: #fff;
  padding: 10px 15px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-tabs {
  display: flex;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #0099FF;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 14px;
  color: #0099FF;
  background-color: #fff;
}

.tab.active {
  background-color: #0099FF;
  color: #fff;
}

/* 日历部分 */
.calendar-section {
  background-color: #fff;
  padding: 15px;
  margin-bottom: 10px;
}

.calendar {
  width: 100%;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.arrow {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0099FF;
  font-weight: bold;
}

.current-month {
  font-size: 16px;
  font-weight: bold;
}

.weekdays {
  display: flex;
  margin-bottom: 5px;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: #999;
}

.days {
  display: flex;
}

.day {
  flex: 1;
  height: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  margin: 0 2px;
  background-color: #f5f5f5;
}

.day.selected {
  background-color: #0099FF;
  color: #fff;
}

.day.today {
  border: 1px solid #0099FF;
}

.day-number {
  font-size: 16px;
  font-weight: bold;
}

.day-text {
  font-size: 12px;
  margin-top: 2px;
}

/* 时间段选择 */
.time-section {
  background-color: #fff;
  padding: 15px;
  margin-bottom: 10px;
}

.time-slots {
  display: flex;
  flex-wrap: wrap;
}

.time-slot {
  width: calc(33.33% - 10px);
  height: 60px;
  margin: 5px;
  border-radius: 8px;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.time-slot.selected {
  background-color: #0099FF;
  color: #fff;
}

.time-slot.disabled {
  background-color: #eee;
  color: #999;
}

.time-text {
  font-size: 14px;
  font-weight: bold;
}

.availability {
  font-size: 12px;
  margin-top: 5px;
}

/* 提交按钮 */
.submit-section {
  padding: 15px;
}

.submit-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background-color: #0099FF;
  color: #fff;
  border-radius: 22px;
  font-size: 16px;
  font-weight: bold;
}

/* 课程列表 */
.course-list {
  padding: 10px;
}

.course-item {
  display: flex;
  background-color: #fff;
  border-radius: 8px;
  margin-bottom: 10px;
  padding: 10px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.course-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  margin-right: 10px;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.course-name {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 5px;
}

.course-desc {
  font-size: 12px;
  color: #666;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.course-price {
  font-size: 16px;
  color: #ff6600;
  font-weight: bold;
}

.course-duration {
  font-size: 12px;
  color: #999;
}