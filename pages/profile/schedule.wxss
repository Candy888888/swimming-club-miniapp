/* schedule.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.tab-header {
  display: flex;
  background-color: white;
  padding: 10rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #0099FF;
  font-weight: bold;
}

.tab-item.active:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 6rpx;
  background-color: #0099FF;
  border-radius: 3rpx;
}

.schedule-list {
  margin-bottom: 30rpx;
}

.schedule-item {
  background-color: white;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  border-left: 8rpx solid #0099FF;
}

.schedule-item.completed {
  border-left-color: #999;
  opacity: 0.8;
}

.schedule-item.cancelled {
  border-left-color: #ff6b6b;
  opacity: 0.7;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.course-time {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 26rpx;
  color: #666;
}

.date {
  margin-right: 20rpx;
}

.time {
  color: #0099FF;
  font-weight: bold;
}

.course-details {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 15rpx;
}

.detail-item {
  font-size: 26rpx;
  color: #666;
  margin-right: 30rpx;
  margin-bottom: 10rpx;
}

.label {
  color: #999;
  margin-right: 10rpx;
}

.course-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #eee;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  background-color: #f0f0f0;
  color: #999;
}

.action-buttons {
  display: flex;
}

.action-buttons button {
  margin-left: 20rpx;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  line-height: 1.5;
  border-radius: 30rpx;
  background-color: white;
}

.btn-cancel {
  color: #ff6b6b;
  border: 1rpx solid #ff6b6b;
}

.btn-remind {
  color: #0099FF;
  border: 1rpx solid #0099FF;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.bottom-tips {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
}