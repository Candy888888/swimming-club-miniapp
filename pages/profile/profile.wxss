/**profile.wxss**/

/* 用户信息区域 */
.user-section {
  background-color: #0099FF;
  padding: 20px 15px;
  color: #fff;
  border-radius: 0 0 15px 15px;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.avatar {
  width: 70px;
  height: 70px;
  border-radius: 35px;
  border: 2px solid #fff;
  margin-right: 15px;
}

.user-detail {
  flex: 1;
}

.username {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 5px;
}

.user-level {
  display: flex;
  align-items: center;
  font-size: 14px;
}

.level-icon {
  width: 16px;
  height: 16px;
  margin-right: 5px;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 5px;
}

.stat-label {
  font-size: 12px;
}

/* 会员卡区域 */
.card-section {
  padding: 15px;
}

.member-card {
  background: linear-gradient(135deg, #0099FF, #0066CC);
  border-radius: 10px;
  padding: 15px;
  color: #fff;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.card-title {
  font-size: 16px;
  font-weight: bold;
}

.card-number {
  font-size: 12px;
  opacity: 0.8;
}

.card-body {
  display: flex;
  justify-content: space-between;
}

.card-info {
  flex: 1;
}

.info-item {
  margin-bottom: 10px;
}

.info-label {
  font-size: 12px;
  opacity: 0.8;
  display: block;
  margin-bottom: 3px;
}

.info-value {
  font-size: 14px;
  font-weight: bold;
}

.card-qrcode {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-image {
  width: 60px;
  height: 60px;
  background-color: #fff;
  padding: 5px;
  border-radius: 5px;
}

.qrcode-tip {
  font-size: 12px;
  margin-top: 5px;
}

/* 功能菜单 */
.menu-section {
  padding: 0 15px;
}

.menu-group {
  margin-bottom: 15px;
  background-color: #fff;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
}

.menu-title {
  font-size: 16px;
  font-weight: bold;
  padding: 15px;
  color: #333;
  border-bottom: 1px solid #f5f5f5;
}

.menu-list {
  padding: 0 15px;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 20px;
  height: 20px;
  margin-right: 10px;
}

.menu-text {
  flex: 1;
  font-size: 14px;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 16px;
}

/* 客服按钮 */
.customer-service {
  padding: 20px 15px;
}

.service-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 22px;
  font-size: 14px;
}