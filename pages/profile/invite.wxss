/* invite.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.invite-header {
  background: linear-gradient(to right, #0099FF, #66CCFF);
  color: white;
  padding: 30rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 153, 255, 0.2);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid white;
  margin-right: 20rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
}

.invite-code-box {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 15rpx 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.code-label {
  font-size: 26rpx;
  margin-right: 20rpx;
}

.code-value {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  flex: 1;
}

.btn-copy {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  background-color: white;
  color: #0099FF;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.5;
}

.invite-actions {
  display: flex;
  justify-content: space-between;
}

.btn-share, .btn-poster {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: transparent;
  color: white;
  font-size: 26rpx;
  padding: 10rpx 0;
  line-height: 1.5;
}

.btn-share image, .btn-poster image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.section-title:before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background-color: #0099FF;
  margin-right: 15rpx;
  border-radius: 4rpx;
}

.rewards-section, .records-section, .rules-section {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.rewards-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.reward-item {
  display: flex;
  align-items: center;
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

.reward-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 15rpx;
}

.reward-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.reward-desc {
  font-size: 24rpx;
  color: #666;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.record-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 5rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-status {
  font-size: 26rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background-color: #f0f0f0;
  border-radius: 6rpx;
}

.record-status.success {
  color: #0099FF;
  background-color: rgba(0, 153, 255, 0.1);
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 15rpx;
}

.rules-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.icon-arrow {
  width: 32rpx;
  height: 32rpx;
}

.rules-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.rule-item {
  margin-bottom: 10rpx;
}