<!--coupon.wxml-->
<view class="container">
  <view class="tab-header">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
      <text>未使用</text>
      <text class="count">({{unusedCoupons.length}})</text>
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
      <text>已使用</text>
      <text class="count">({{usedCoupons.length}})</text>
    </view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">
      <text>已过期</text>
      <text class="count">({{expiredCoupons.length}})</text>
    </view>
  </view>
  
  <view class="coupon-list">
    <!-- 未使用优惠券 -->
    <block wx:if="{{currentTab === 0}}">
      <view class="coupon-item" wx:for="{{unusedCoupons}}" wx:key="id">
        <view class="coupon-card">
          <view class="coupon-left">
            <view class="coupon-value">
              <text class="symbol" wx:if="{{item.type === 'discount'}}">折</text>
              <text class="symbol" wx:else>¥</text>
              <text class="amount">{{item.value}}</text>
            </view>
            <view class="coupon-condition">{{item.condition}}</view>
          </view>
          <view class="coupon-divider"></view>
          <view class="coupon-right">
            <view class="coupon-name">{{item.name}}</view>
            <view class="coupon-time">{{item.validPeriod}}</view>
            <view class="coupon-desc">{{item.description}}</view>
            <view class="coupon-btn" bindtap="useCoupon" data-id="{{item.id}}">立即使用</view>
          </view>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{unusedCoupons.length === 0}}">
        <image src="/images/icons/empty.png" class="empty-icon"></image>
        <text>暂无可用优惠券</text>
      </view>
    </block>
    
    <!-- 已使用优惠券 -->
    <block wx:if="{{currentTab === 1}}">
      <view class="coupon-item used" wx:for="{{usedCoupons}}" wx:key="id">
        <view class="coupon-card">
          <view class="coupon-left">
            <view class="coupon-value">
              <text class="symbol" wx:if="{{item.type === 'discount'}}">折</text>
              <text class="symbol" wx:else>¥</text>
              <text class="amount">{{item.value}}</text>
            </view>
            <view class="coupon-condition">{{item.condition}}</view>
          </view>
          <view class="coupon-divider"></view>
          <view class="coupon-right">
            <view class="coupon-name">{{item.name}}</view>
            <view class="coupon-time">{{item.validPeriod}}</view>
            <view class="coupon-desc">{{item.description}}</view>
            <view class="coupon-status">已使用</view>
          </view>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{usedCoupons.length === 0}}">
        <image src="/images/icons/empty.png" class="empty-icon"></image>
        <text>暂无已使用优惠券</text>
      </view>
    </block>
    
    <!-- 已过期优惠券 -->
    <block wx:if="{{currentTab === 2}}">
      <view class="coupon-item expired" wx:for="{{expiredCoupons}}" wx:key="id">
        <view class="coupon-card">
          <view class="coupon-left">
            <view class="coupon-value">
              <text class="symbol" wx:if="{{item.type === 'discount'}}">折</text>
              <text class="symbol" wx:else>¥</text>
              <text class="amount">{{item.value}}</text>
            </view>
            <view class="coupon-condition">{{item.condition}}</view>
          </view>
          <view class="coupon-divider"></view>
          <view class="coupon-right">
            <view class="coupon-name">{{item.name}}</view>
            <view class="coupon-time">{{item.validPeriod}}</view>
            <view class="coupon-desc">{{item.description}}</view>
            <view class="coupon-status">已过期</view>
          </view>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{expiredCoupons.length === 0}}">
        <image src="/images/icons/empty.png" class="empty-icon"></image>
        <text>暂无已过期优惠券</text>
      </view>
    </block>
  </view>
  
  <view class="action-section">
    <button class="action-btn" bindtap="showCouponCode">兑换优惠券</button>
  </view>
</view>