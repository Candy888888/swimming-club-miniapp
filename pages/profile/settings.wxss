.item-title {
  font-size: 30rpx;
  color: #333;
}

.item-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #bbb;
  border-right: 2rpx solid #bbb;
  transform: rotate(45deg);
}

.cache-size, .version-info {
  font-size: 26rpx;
  color: #999;
}

/* 退出登录 */
.logout-section {
  padding: 30rpx;
  margin-top: 60rpx;
}

.logout-btn {
  background-color: #fff;
  color: #FF3B30;
  font-size: 30rpx;
  border-radius: 40rpx;
  width: 100%;
  border: 1rpx solid #FF3B30;
}