/* membership.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.header-bg {
  width: 100%;
  height: 100%;
  filter: brightness(0.7);
}

.header-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  z-index: 1;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.tab-header {
  display: flex;
  background-color: white;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding: 10rpx 0;
}

.tab-item.active {
  color: #0099FF;
  font-weight: bold;
}

.tab-item.active:after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #0099FF;
  border-radius: 2rpx;
}

.tab-content {
  padding: 30rpx 20rpx;
}

/* 会员权益 */
.membership-phase-selector {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
  background-color: white;
  border-radius: 10rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.phase-btn {
  padding: 15rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  margin: 0 10rpx;
}

.phase-btn.active {
  background-color: #0099FF;
  color: white;
  font-weight: bold;
}

.membership-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.membership-card {
  background-color: white;
  border-radius: 15rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.card-image {
  width: 100%;
  height: 200rpx;
  display: block;
}

.card-header {
  padding: 20rpx;
  border-bottom: 1px solid #eee;
}

.card-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.card-duration {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.card-price-section {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.price-symbol {
  font-size: 28rpx;
  margin-right: 4rpx;
  color: #FF2D55;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF2D55;
}

.original-price {
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 15rpx;
  color: #999;
}

.recommended-tag {
  position: absolute;
  top: 20rpx;
  right: -30rpx;
  background-color: #FF9500;
  color: white;
  font-size: 22rpx;
  padding: 6rpx 30rpx;
  transform: rotate(45deg);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  z-index: 2;
}

.card-content {
  padding: 0 20rpx 30rpx;
}

.benefits-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin: 20rpx 0 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1px dashed #eee;
}

.benefits-list {
  margin-bottom: 30rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 26rpx;
  color: #333;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 15rpx;
}

.join-btn {
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 20rpx 0;
  width: 100%;
  text-align: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  background-color: #0099FF;
}

/* 会员评价 */
.testimonial-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.testimonial-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.testimonial-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.user-level {
  font-size: 24rpx;
  color: #0099FF;
}

.rating {
  display: flex;
}

.star {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.testimonial-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 常见问题 */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.faq-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

.faq-answer {
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1px solid #eee;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 联系客服 */
.contact-section {
  padding: 30rpx 20rpx 50rpx;
  text-align: center;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.contact-btn {
  background-color: #0099FF;
  color: white;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 20rpx 0;
  width: 60%;
  margin: 0 auto;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}