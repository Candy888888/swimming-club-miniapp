<!--wallet.wxml-->
<view class="container">
  <view class="wallet-header">
    <view class="balance-section">
      <view class="balance-label">账户余额</view>
      <view class="balance-amount">¥{{balance}}</view>
      <view class="balance-actions">
        <button class="action-btn" bindtap="showRecharge">充值</button>
        <button class="action-btn" bindtap="showWithdraw">提现</button>
      </view>
    </view>
  </view>
  
  <view class="wallet-tabs">
    <view class="tab {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">交易记录</view>
    <view class="tab {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">我的银行卡</view>
  </view>
  
  <view class="wallet-content">
    <!-- 交易记录 -->
    <view class="transaction-list" wx:if="{{currentTab === 0}}">
      <view class="transaction-item" wx:for="{{transactions}}" wx:key="id">
        <view class="transaction-info">
          <view class="transaction-title">{{item.title}}</view>
          <view class="transaction-time">{{item.time}}</view>
        </view>
        <view class="transaction-amount {{item.type === 'income' ? 'income' : 'expense'}}">
          {{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}
        </view>
      </view>
      
      <view class="empty-tip" wx:if="{{transactions.length === 0}}">
        <image src="/images/icons/empty.png" class="empty-icon"></image>
        <text>暂无交易记录</text>
      </view>
    </view>
    
    <!-- 我的银行卡 -->
    <view class="card-list" wx:if="{{currentTab === 1}}">
      <view class="bank-card" wx:for="{{bankCards}}" wx:key="id" style="background-color: {{item.color}}">
        <view class="card-type">{{item.type}}</view>
        <view class="card-number">**** **** **** {{item.lastFourDigits}}</view>
        <view class="card-info">
          <view class="card-bank">{{item.bank}}</view>
          <image class="card-logo" src="{{item.logo}}"></image>
        </view>
      </view>
      
      <view class="add-card" bindtap="addBankCard">
        <image src="/images/icons/add.png" class="add-icon"></image>
        <text>添加银行卡</text>
      </view>
      
      <view class="empty-tip" wx:if="{{bankCards.length === 0}}">
        <image src="/images/icons/empty.png" class="empty-icon"></image>
        <text>暂无绑定银行卡</text>
      </view>
    </view>
  </view>
</view>