<!--profile.wxml-->
<view class="page">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <view class="user-info">
      <image src="{{userInfo.avatarUrl || '/images/icons/default-avatar.png'}}" class="avatar"></image>
      <view class="user-detail">
        <view class="username">{{userInfo.nickName || '游客'}}</view>
        <view class="user-level">
          <image src="/images/icons/vip.png" class="level-icon"></image>
          <text>{{userInfo.memberLevel || '普通会员'}}</text>
        </view>
      </view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-num">{{userInfo.points || 0}}</text>
        <text class="stat-label">积分</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userInfo.coupons || 0}}</text>
        <text class="stat-label">优惠券</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userInfo.balance || 0}}</text>
        <text class="stat-label">余额</text>
      </view>
    </view>
  </view>
  
  <!-- 会员卡区域 -->
  <view class="card-section">
    <view class="member-card">
      <view class="card-header">
        <view class="card-title">新升潮游泳馆会员卡</view>
        <view class="card-number">NO.{{userInfo.cardNumber || '未开通'}}</view>
      </view>
      <view class="card-body">
        <view class="card-info">
          <view class="info-item">
            <text class="info-label">有效期至</text>
            <text class="info-value">{{userInfo.cardExpireDate || '未开通'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">剩余次数</text>
            <text class="info-value">{{userInfo.remainingTimes || 0}}次</text>
          </view>
        </view>
        <view class="card-qrcode">
          <image src="/images/icons/qrcode.png" class="qrcode-image"></image>
          <text class="qrcode-tip">出示二维码</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-title">我的服务</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/booking">
          <image src="/images/icons/booking.png" class="menu-icon"></image>
          <text class="menu-text">我的预约</text>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/course">
          <image src="/images/icons/course.png" class="menu-icon"></image>
          <text class="menu-text">我的课程</text>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/card">
          <image src="/images/icons/card.png" class="menu-icon"></image>
          <text class="menu-text">会员卡管理</text>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/growth">
          <image src="/images/icons/growth.png" class="menu-icon"></image>
          <text class="menu-text">会员成长记录</text>
          <text class="menu-arrow">></text>
        </view>
      </view>
    </view>
    
    <view class="menu-group">
      <view class="menu-title">其他服务</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/wallet">
          <image src="/images/icons/wallet.png" class="menu-icon"></image>
          <text class="menu-text">我的钱包</text>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/coupon">
          <image src="/images/icons/coupon.png" class="menu-icon"></image>
          <text class="menu-text">优惠券</text>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/feedback">
          <image src="/images/icons/feedback.png" class="menu-icon"></image>
          <text class="menu-text">意见反馈</text>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/settings">
          <image src="/images/icons/settings.png" class="menu-icon"></image>
          <text class="menu-text">设置</text>
          <text class="menu-arrow">></text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 客服按钮 -->
  <view class="customer-service">
    <button class="service-btn" open-type="contact">联系客服</button>
  </view>
</view>