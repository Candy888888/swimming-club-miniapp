<!--schedule.wxml-->
<view class="container">
  <view class="tab-header">
    <view class="tab-item {{activeTab === 'upcoming' ? 'active' : ''}}" bindtap="switchTab" data-tab="upcoming">即将开始</view>
    <view class="tab-item {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
    <view class="tab-item {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
  </view>
  
  <view class="schedule-list">
    <block wx:for="{{scheduleList}}" wx:key="id">
      <view class="schedule-item {{item.status}}" wx:if="{{activeTab === 'all' || item.status === activeTab}}">
        <view class="course-info" bindtap="viewCourseDetail" data-id="{{item.id}}">
          <view class="course-name">{{item.courseName}}</view>
          <view class="course-time">
            <text class="date">{{item.date}}</text>
            <text class="time">{{item.time}}</text>
          </view>
          <view class="course-details">
            <view class="detail-item">
              <text class="label">教练:</text>
              <text class="value">{{item.coach}}</text>
            </view>
            <view class="detail-item">
              <text class="label">地点:</text>
              <text class="value">{{item.location}}</text>
            </view>
          </view>
        </view>
        
        <view class="course-actions">
          <view class="status-badge" wx:if="{{item.status === 'completed'}}">已完成</view>
          <view class="status-badge" wx:elif="{{item.status === 'cancelled'}}">已取消</view>
          <view class="action-buttons" wx:if="{{item.status === 'upcoming'}}">
            <button class="btn-cancel" bindtap="cancelCourse" data-id="{{item.id}}">取消</button>
            <button class="btn-remind">提醒</button>
          </view>
        </view>
      </view>
    </block>
    
    <view class="empty-tip" wx:if="{{getFilteredSchedule().length === 0}}">
      <image class="empty-icon" src="/images/icons/empty.png"></image>
      <text>暂无课程记录</text>
    </view>
  </view>
  
  <view class="bottom-tips">
    <text>温馨提示：课程开始前2小时可免费取消</text>
  </view>
</view>