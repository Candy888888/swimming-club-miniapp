/**index.wxss**/

/* 顶部大Banner */
.top-banner {
  width: 100%;
  height: 200px;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 功能导航区 */
.nav-section {
  background-color: #fff;
  padding: 20px 10px;
  margin-top: 15px;
  margin-bottom: 15px;
  position: relative;
  z-index: 1;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.nav-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 5px;
}

.nav-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 10px;
  padding-top: 5px;
}

.nav-icon {
  width: 45px;
  height: 45px;
  margin-bottom: 8px;
}

.nav-text {
  font-size: 13px;
  color: #333;
  font-weight: 500;
  text-align: center;
  width: 100%;
}

/* 小Banner区域 */
.promo-section {
  background-color: #fff;
  padding: 10px;
  margin-bottom: 10px;
}

.promo-title {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.promo-icon {
  width: 20px;
  height: 20px;
  margin-right: 5px;
}

.promo-banner {
  width: 100%;
  height: 120px;
}

.promo-image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}

/* 泳队介绍 */
.teams-section {
  background-color: #fff;
  padding-bottom: 15px;
  margin-bottom: 10px;
}

.teams-grid {
  padding: 0 10px;
}

.team-item {
  margin-bottom: 10px;
}

.team-card {
  display: flex;
  align-items: center;
  padding: 10px;
  background-color: #f9f9f9;
  border-radius: 8px;
}

.team-logo {
  width: 50px;
  height: 50px;
  margin-right: 10px;
  border-radius: 25px;
}

.team-info {
  flex: 1;
}

.team-name {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  display: block;
}

.team-desc {
  font-size: 12px;
  color: #666;
  display: block;
}

/* 推荐赛事 */
.events-section {
  background-color: #fff;
  padding-bottom: 15px;
  margin-bottom: 10px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  padding: 15px 15px 10px;
  color: #333;
}

.events-scroll {
  width: 100%;
}

.events-list {
  white-space: nowrap;
  padding: 0 10px;
}

.events-list .event-item {
  display: inline-block;
  width: 250px;
  margin-right: 10px;
}

.event-card {
  background-color: #f9f9f9;
  border-radius: 8px;
  overflow: hidden;
}

.event-cover {
  width: 100%;
  height: 125px;
  border-radius: 8px 8px 0 0;
}

.event-info {
  padding: 8px;
}

.event-title {
  font-size: 14px;
  font-weight: bold;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-date {
  font-size: 12px;
  color: #666;
  display: block;
  margin: 5px 0;
}

.event-status {
  font-size: 12px;
  color: #0099FF;
}

/* 推荐视频 */
.videos-section {
  background-color: #fff;
  padding-bottom: 15px;
  margin-bottom: 10px;
}

.videos-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 5px;
}

.video-item {
  width: 50%;
  padding: 5px;
  box-sizing: border-box;
}

.video-card {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
}

.video-cover {
  width: 100%;
  height: 100px;
  border-radius: 8px 8px 0 0;
}

.video-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 30px;
  height: 30px;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-play-icon .play-icon {
  width: 15px;
  height: 15px;
}

.video-info {
  padding: 8px;
  background-color: #f9f9f9;
  border-radius: 0 0 8px 8px;
}

.video-title {
  font-size: 14px;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-views {
  font-size: 12px;
  color: #999;
  display: block;
  margin-top: 3px;
}