/* specialty.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  background-color: #0099FF;
  color: white;
  padding: 30rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.program-list {
  margin-bottom: 30rpx;
}

.program-item {
  background-color: white;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.program-image {
  width: 100%;
  height: 300rpx;
}

.program-info {
  padding: 20rpx;
}

.program-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.program-description {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.5;
}

.program-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #0099FF;
}

.program-duration, .program-suitable {
  background-color: rgba(0, 153, 255, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.notice {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.notice-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #333;
  border-left: 8rpx solid #0099FF;
  padding-left: 15rpx;
}

.notice-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.notice-item {
  margin-bottom: 10rpx;
}