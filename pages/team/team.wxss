/**team.wxss**/

.team-banner {
  position: relative;
  width: 100%;
  height: 200px;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-text {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: #fff;
  font-size: 24px;
  font-weight: bold;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.team-tabs {
  display: flex;
  background-color: #fff;
  padding: 10px 15px;
  margin-bottom: 10px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 16px;
  color: #666;
  position: relative;
}

.tab.active {
  color: #0099FF;
  font-weight: bold;
}

.tab.active:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 30px;
  height: 3px;
  background-color: #0099FF;
  border-radius: 3px;
}

/* 泳队列表 */
.team-list {
  padding: 10px;
}

.team-item {
  margin-bottom: 15px;
}

.team-card {
  display: flex;
  background-color: #fff;
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  position: relative;
}

.team-logo {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  margin-right: 15px;
}

.team-info {
  flex: 1;
}

.team-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 5px;
}

.team-desc {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.team-stats {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  margin-right: 15px;
  font-size: 12px;
  color: #999;
}

.stat-value {
  color: #0099FF;
}

.team-arrow {
  position: absolute;
  right: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 18px;
}

/* 加入泳队按钮 */
.team-join-btn {
  display: inline-block;
  margin-top: 8px;
  padding: 4px 12px;
  background-color: #0099FF;
  color: white;
  font-size: 14px;
  border-radius: 15px;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.team-join-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 5px;
  height: 5px;
  background: rgba(255, 255, 255, 0.5);
  opacity: 0;
  border-radius: 100%;
  transform: scale(1, 1) translate(-50%, -50%);
  transform-origin: 50% 50%;
}

.team-join-btn:active::after {
  animation: ripple 0.4s ease-out;
}

@keyframes ripple {
  0% {
    transform: scale(0, 0);
    opacity: 0.5;
  }
  100% {
    transform: scale(20, 20);
    opacity: 0;
  }
}

.team-join-btn.joined {
  background-color: #FF6B6B;
  transform: scale(1.05);
}

/* 教练列表 */
.coach-list {
  padding: 10px;
}

.coach-item {
  margin-bottom: 15px;
}

.coach-card {
  display: flex;
  background-color: #fff;
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.coach-avatar {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  margin-right: 15px;
}

.coach-info {
  flex: 1;
}

.coach-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
}

.coach-title {
  font-size: 14px;
  color: #0099FF;
  margin-bottom: 5px;
}

.coach-desc {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.coach-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 2px 8px;
  background-color: #f0f9ff;
  color: #0099FF;
  border-radius: 4px;
  font-size: 12px;
  margin-right: 5px;
  margin-bottom: 5px;
}