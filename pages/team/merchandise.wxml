<!--merchandise.wxml-->
<view class="container">
  <view class="search-box">
    <view class="search-input-wrap">
      <image class="search-icon" src="/images/icons/search.png"></image>
      <input class="search-input" placeholder="搜索游泳周边" value="{{searchValue}}" bindinput="onSearch" confirm-type="search"/>
      <image wx:if="{{searchValue}}" class="clear-icon" src="/images/icons/clear.png" bindtap="clearSearch"></image>
    </view>
  </view>
  
  <view class="category-section">
    <scroll-view class="category-scroll" scroll-x="true" enhanced show-scrollbar="false">
      <view class="category-list">
        <view class="category-item {{item.active ? 'active' : ''}}" 
              wx:for="{{categories}}" 
              wx:key="id"
              bindtap="selectCategory"
              data-id="{{item.id}}"
              data-name="{{item.name}}">
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <view class="sort-section">
    <view class="sort-item {{sortType === 'default' ? 'active' : ''}}" bindtap="changeSort" data-type="default">
      <text>默认</text>
    </view>
    <view class="sort-item {{sortType === 'sales' ? 'active' : ''}}" bindtap="changeSort" data-type="sales">
      <text>销量</text>
    </view>
    <view class="sort-item {{sortType === 'price-asc' || sortType === 'price-desc' ? 'active' : ''}}" bindtap="changeSort" data-type="{{sortType === 'price-asc' ? 'price-desc' : 'price-asc'}}">
      <text>价格</text>
      <view class="price-arrows">
        <view class="arrow up {{sortType === 'price-asc' ? 'active' : ''}}"></view>
        <view class="arrow down {{sortType === 'price-desc' ? 'active' : ''}}"></view>
      </view>
    </view>
  </view>
  
  <view class="product-section">
    <view class="product-list">
      <view class="product-item" 
            wx:for="{{getFilteredProducts()}}" 
            wx:key="id"
            bindtap="viewProduct"
            data-id="{{item.id}}">
        <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
          </view>
          <view class="product-price-row">
            <view class="price-section">
              <text class="price">¥{{item.price}}</text>
              <text class="original-price">¥{{item.originalPrice}}</text>
            </view>
            <view class="cart-btn" catchtap="addToCart" data-id="{{item.id}}">
              <image src="/images/icons/cart-add.png"></image>
            </view>
          </view>
          <view class="product-meta">
            <view class="rating">
              <image src="/images/icons/star.png"></image>
              <text>{{item.rating}}</text>
            </view>
            <text class="sales">销量 {{item.sales}}</text>
          </view>
        </view>
      </view>
      
      <view class="empty-tip" wx:if="{{getFilteredProducts().length === 0}}">
        <image class="empty-icon" src="/images/icons/empty-cart.png"></image>
        <text>暂无相关商品</text>
      </view>
    </view>
  </view>
  
  <view class="bottom-tip">
    <text>— 已经到底啦 —</text>
  </view>
</view>