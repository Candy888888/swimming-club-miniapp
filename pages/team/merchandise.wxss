/* merchandise.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  padding: 10rpx 0 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.search-icon, .clear-icon {
  width: 36rpx;
  height: 36rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.category-section {
  margin: 20rpx 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 10rpx 0;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  background-color: white;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.category-item.active {
  background-color: #0099FF;
  color: white;
}

.sort-section {
  display: flex;
  background-color: white;
  padding: 20rpx;
  margin: 20rpx 0;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.sort-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.sort-item.active {
  color: #0099FF;
  font-weight: bold;
}

.sort-item:not(:last-child):after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1px;
  background-color: #eee;
}

.price-arrows {
  display: flex;
  flex-direction: column;
  margin-left: 6rpx;
  height: 30rpx;
}

.arrow {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
}

.arrow.up {
  border-bottom: 6rpx solid #999;
  margin-bottom: 4rpx;
}

.arrow.down {
  border-top: 6rpx solid #999;
}

.arrow.active {
  border-bottom-color: #0099FF;
  border-top-color: #0099FF;
}

.product-section {
  margin-bottom: 30rpx;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-item {
  width: 48%;
  background-color: white;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.product-image {
  width: 100%;
  height: 350rpx;
}

.product-info {
  padding: 15rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  height: 80rpx;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 22rpx;
  color: #0099FF;
  background-color: rgba(0, 153, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.product-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.price-section {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4400;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.cart-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: #0099FF;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cart-btn image {
  width: 36rpx;
  height: 36rpx;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.rating {
  display: flex;
  align-items: center;
}

.rating image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.empty-tip {
  width: 100%;
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.bottom-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}