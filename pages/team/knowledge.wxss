/* knowledge.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-box {
  padding: 10rpx 0 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.search-icon, .clear-icon {
  width: 36rpx;
  height: 36rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.category-section {
  margin: 20rpx 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 10rpx 0;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  background-color: white;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.category-item.active {
  background-color: #0099FF;
  color: white;
}

.category-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.section-title:before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background-color: #0099FF;
  margin-right: 15rpx;
  border-radius: 4rpx;
}

.recommended-list {
  display: flex;
  overflow-x: auto;
  padding: 10rpx 0;
}

.recommended-item {
  width: 500rpx;
  margin-right: 20rpx;
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.recommended-cover {
  width: 100%;
  height: 250rpx;
}

.recommended-info {
  padding: 15rpx;
}

.recommended-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommended-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.category-tag {
  color: #0099FF;
  background-color: rgba(0, 153, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.article-list {
  margin-bottom: 30rpx;
}

.article-item {
  display: flex;
  background-color: white;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.article-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.article-info {
  flex: 1;
  padding: 15rpx;
  display: flex;
  flex-direction: column;
}

.article-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-summary {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.publish-date {
  color: #999;
}

.interaction {
  display: flex;
}

.likes, .views {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.likes image, .views image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}