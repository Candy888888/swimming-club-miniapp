<!--team.wxml-->
<view class="page">
  <view class="team-banner">
    <image src="/images/banner/banner1.jpg" mode="aspectFill" class="banner-image"></image>
    <view class="banner-text">专业游泳训练团队</view>
  </view>
  
  <view class="team-tabs">
    <view class="tab {{activeTab === 'teams' ? 'active' : ''}}" bindtap="switchTab" data-tab="teams">泳队介绍</view>
    <view class="tab {{activeTab === 'coaches' ? 'active' : ''}}" bindtap="switchTab" data-tab="coaches">教练团队</view>
  </view>
  
  <view class="team-content" wx:if="{{activeTab === 'teams'}}">
    <view class="team-list">
      <view class="team-item" wx:for="{{teams}}" wx:key="id" bindtap="navigateToTeamDetail" data-id="{{item.id}}">
        <view class="team-card">
          <image src="{{item.logo}}" class="team-logo"></image>
          <view class="team-info">
            <view class="team-name">{{item.name}}</view>
            <view class="team-desc">{{item.description}}</view>
            <view class="team-stats">
            <view class="stat-item">
              <text class="stat-label">年龄段：</text>
              <text class="stat-value">{{item.ageRange}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-label">教练数：</text>
              <text class="stat-value">{{item.coachCount}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-label">学员数：</text>
              <text class="stat-value">{{item.studentCount}}</text>
            </view>
          </view>
          <view class="team-join-btn {{item.joined ? 'joined' : ''}}" catchtap="toggleJoinTeam" data-id="{{item.id}}">
            <text wx:if="{{item.joined}}">✓ 已加入</text>
            <text wx:else="">+ 加入泳队</text>
          </view>
          </view>
          <view class="team-arrow">></view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="team-content" wx:if="{{activeTab === 'coaches'}}">
    <view class="coach-list">
      <view class="coach-item" wx:for="{{coaches}}" wx:key="id" bindtap="navigateToCoachDetail" data-id="{{item.id}}">
        <view class="coach-card">
          <image src="{{item.avatar}}" class="coach-avatar"></image>
          <view class="coach-info">
            <view class="coach-name">{{item.name}}</view>
            <view class="coach-title">{{item.title}}</view>
            <view class="coach-desc">{{item.description}}</view>
            <view class="coach-tags">
              <view class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>